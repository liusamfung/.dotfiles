;; Quick app launcher and floating apps (held from "a", and from the hyper keys on the control layers).

(defalias
  app-dict S-C-A-M-d ;; easydictionary (https://github.com/tisfeng/Easydict)
  wm-quake A-102d ;; this is '`'
  ;; Hammerspoon toggles the app by name (modules/app_toggler.lua)
  hs-notes (cmd open "hammerspoon://toggleapp?name=Notes")
  hs-sim   (cmd open "hammerspoon://toggleapp?name=Simulator")
  hs-cam   (cmd open "hammerspoon://toggleapp?name=Quick Camera")
  pw-quick S-C-A-M-p

  hy-cal  S-C-A-M-c
  hy-f1   S-C-A-M-f1
  ctl-tab C-tab
  hy-f4   S-C-A-M-f4
  hy-f5   S-C-A-M-f5
  hy-f6   S-C-A-M-f6
  hy-f7   S-C-A-M-f7
  hy-f8   S-C-A-M-f8
  hy-f9   S-C-A-M-f9
  hy-f10  S-C-A-M-f10
  hy-f11  S-C-A-M-f11
  hy-f12  S-C-A-M-f12
)

(deflayer quick-apps
  esc       @hy-f1    @wm-wsprv @ctl-tab  @hy-f4    @hy-f5    @hy-f6    @hy-f7    @hy-f8    @hy-f9    @hy-f10   @hy-f11   @hy-f12
  102d      XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX
  XX        XX        XX        XX        @pw-quick XX        XX        XX        @hy-cal   XX        XX        XX        XX        XX
  F3        XX        XX        XX        XX        XX        @app-dict @rc-clip  @wm-quake @hs-notes @hs-sim   XX        XX
  @wm-wsprv XX        XX        XX        XX        XX        XX        @rc-rain  XX        XX        XX        XX        rsft
  fn        lctl      lalt      XX        @hs-cam                                 rmet      ralt      left      down      up        rght
)
