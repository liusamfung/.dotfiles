;; Hyper-key / macOS shortcuts shared by several layers.

(defalias
  ;; Utilitys

  hr-scrl  S-C-A-M-2
  hr-click S-C-A-M-7
  hr-srch  S-C-A-M-3
  sys-lock C-M-q
  sys-dnd  S-C-A-.
  sys-kill A-M-esc
  sys-ntf  S-C-A-u
  sys-zin  A-M-'
  sys-zout A-M--
  sys-ztog A-M-8

  mic-mute S-C-A-M-m

  app-tab M-tab
  opt-n   (macro A-n)
  opt-e   (macro A-e)
  opt-u   (macro A-u)
)
