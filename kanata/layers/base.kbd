;; Base layer: the first deflayer, so kanata starts on it.

;; lrld reloads layers, aliases and defsrc, but not defcfg (e.g. macos-dev-names-include): restart kanata for those.
(deflayer base
  lrld      f1        @mic-mute f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  caps      @~        @[        @ly-scr   @lpar     @pct-1pw  @$        @rpar     @}        @]        @+        @`        @#        rght
  tab       @mod-la   @mod-lc   @mod-lm   @mod-ls   y         f         @mod-rs   @mod-rm   @mod-rc   @mod-ra   @/        @at-1pw   left
  esc       @ly-qck   @ly-tab   @ly-ws    @ly-ses   i         d         @ly-term  @ly-pane  @ly-win   @ly-sys   -         \
  @ly-lsft  @ly-lsft  @;        q         j         k         x         b         m         w         v         z         @ly-rsft
  fn        XX        XX        @ly-ctl   @ly-num                                 @ly-rctl  XX        left      down      up        rght
)
