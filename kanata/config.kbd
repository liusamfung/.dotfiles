(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  concurrent-tap-hold yes
)

;; Machine-specific values ($user, $cycle-script). kanata/local.kbd is not tracked by git; install.sh writes it
;; (copy local.kbd.example by hand otherwise). kanata silently ignores an include whose file is missing, so the
;; alias below uses a number that only local.kbd defines: without the file `kanata --check` fails loudly
;; instead of leaving every `sudo -u $user ...` key broken.
(include local.kbd)
(defalias _require-local-kbd (tap-hold $local-kbd-loaded 1 a a))


(defvar
  tap-time 20 ;; Deshabilitamos el tapcontinous porque interfiere con mi num_lyr

  hold-time  150
  subl-time 200
 tmux-delay 40
 chord-time 250
)
(defalias
 ;;Raycast variables


 c_clipb (cmd open raycast://extensions/raycast/clipboard-history/clipboard-history)
 k_killp (cmd open raycast://extensions/rolandleth/kill-process/index) ;;It's similar to Activity Monitor
 b_raind (cmd open raycast://extensions/lardissone/raindrop-io/search) ;; Invoke 'raindrop.io search bookmarks'(Raycast's plugin). Plus, Raindrop.io is page for save all your bookmarks for use in anywhre
 y_ytvid (cmd open raycast://extensions/tonka3000/youtube/search-videos?arguments=%7B%22query%22%3A%22%22%7D) ;;Invoke 'Youtube Search' (Plugin) find videos with autosuggestion anywhere and open direct
 e_emoji (cmd open raycast://extensions/raycast/emoji-symbols/search-emoji-symbols) ;;Invoke 'emoji-symbols' (Native)
 f_files (cmd open raycast://extensions/raycast/file-search/search-files) 
 g_googl (cmd open raycast://extensions/mblode/google-search/index) ;;Invoke 'Google Search' (Plugin) Search in google with autosuggestion anywhere and open direct in new tab 
 h_gihub (cmd open raycast://extensions/raycast/github/search-repositories) ;; Invoke 'Github search repositories'(Plugin)
 d_dwnYT (cmd open raycast://extensions/vimtor/video-downloader/index) ;; Youtube video-downloader with  'yt-dlp'(github)
)

(defalias

  h_spac1 (cmd sudo -u $user omniwmctl command switch-workspace 1)
  t_spac2 (cmd sudo -u $user omniwmctl command switch-workspace 2)
  n_spac3 (cmd sudo -u $user omniwmctl command switch-workspace 3)
  g_spac4 (cmd sudo -u $user omniwmctl command switch-workspace 4)
  c_spac5 (cmd sudo -u $user omniwmctl command switch-workspace 5)
  r_spac6 (cmd sudo -u $user omniwmctl command switch-workspace 6)
  7_spac7 (cmd sudo -u $user omniwmctl command switch-workspace 7)
  8_spac8 (cmd sudo -u $user omniwmctl command switch-workspace 8)
  9_spac9 (cmd sudo -u $user omniwmctl command switch-workspace 9)

  lastSpc (cmd sudo -u $user omniwmctl command switch-workspace back-and-forth)
    lastWin (cmd sudo -u $user $cycle-script)

  )

(defalias

  test_c (cmd sudo -u $user omniwmctl command toggle-focused-window-floating)
  s_split (cmd sudo -u $user omniwmctl command toggle-split)
  x_close (cmd sudo -u $user omniwmctl command close-focused-window)
  m_minim M-m
  h_hideW M-h



  h_westt (cmd sudo -u $user omniwmctl command focus left)
  t_south (cmd sudo -u $user omniwmctl command focus down)
  c_north (cmd sudo -u $user omniwmctl command focus up)
  n_eastt (cmd sudo -u $user omniwmctl command focus right)


  x_maxWi (cmd sudo -u $user omniwmctl command toggle-native-fullscreen)
  z_fulls (cmd sudo -u $user omniwmctl command toggle-fullscreen)
 ;;
  )

