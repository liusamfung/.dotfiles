;; OmniWM workspaces (held from "e"): go to / send window to workspace N, back-and-forth.

(defalias
  wm-ws1 (cmd sudo -u $user omniwmctl command switch-workspace 1)
  wm-ws2 (cmd sudo -u $user omniwmctl command switch-workspace 2)
  wm-ws3 (cmd sudo -u $user omniwmctl command switch-workspace 3)
  wm-ws4 (cmd sudo -u $user omniwmctl command switch-workspace 4)
  wm-ws5 (cmd sudo -u $user omniwmctl command switch-workspace 5)
  wm-ws6 (cmd sudo -u $user omniwmctl command switch-workspace 6)
  wm-ws7 (cmd sudo -u $user omniwmctl command switch-workspace 7)
  wm-ws8 (cmd sudo -u $user omniwmctl command switch-workspace 8)
  wm-ws9 (cmd sudo -u $user omniwmctl command switch-workspace 9)

  wm-wsprv (cmd sudo -u $user omniwmctl command switch-workspace back-and-forth)
  wm-cycle (cmd sudo -u $user $cycle-script)
)

(deflayer workspaces
  esc       f1        f2        f3        f4        f5        f         f7        f8        f9        f10       f11       f12
  102d      XX        XX        XX        XX        XX        XX        @wm-ws7   @wm-ws8   @wm-ws9   XX        XX        XX        XX
  tab       XX        XX        XX        XX        XX        XX        @wm-ws4   @wm-ws5   @wm-ws6   XX        XX        XX        XX
  @ly-wsmv  XX        XX        XX        XX        XX        XX        @wm-ws1   @wm-ws2   @wm-ws3   XX        XX        XX
  lsft      caps      XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        rsft
  fn        lctl      lalt      lmet      @ly-wsmv                                rmet      ralt      left      down      up        rght
)

(defalias
  wm-mv1 (cmd sudo -u $user omniwmctl command move-to-workspace slot 1)
  wm-mv2 (cmd sudo -u $user omniwmctl command move-to-workspace slot 2)
  wm-mv3 (cmd sudo -u $user omniwmctl command move-to-workspace slot 3)
  wm-mv4 (cmd sudo -u $user omniwmctl command move-to-workspace slot 4)
  wm-mv5 (cmd sudo -u $user omniwmctl command move-to-workspace slot 5)
  wm-mv6 (cmd sudo -u $user omniwmctl command move-to-workspace slot 6)
  wm-mv7 (cmd sudo -u $user omniwmctl command move-to-workspace slot 7)
  wm-mv8 (cmd sudo -u $user omniwmctl command move-to-workspace slot 8)
  wm-mv9 (cmd sudo -u $user omniwmctl command move-to-workspace slot 9)
)

(deflayer workspaces-move
  esc       f1        f2        f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  102d      XX        XX        XX        XX        XX        XX        @wm-mv7   @wm-mv8   @wm-mv9   XX        XX        XX        XX
  tab       XX        XX        XX        XX        XX        XX        @wm-mv4   @wm-mv5   @wm-mv6   XX        XX        XX        XX
  esc       XX        XX        XX        XX        XX        XX        @wm-mv1   @wm-mv2   @wm-mv3   XX        XX        XX
  lsft      caps      XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        rsft
  fn        lctl      lalt      lmet      spc                                     rmet      ralt      left      down      up        rght
)
