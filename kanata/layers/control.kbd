;; Layers held from the Control keys (backspace / return on the base layer).

(deflayer control-l
  esc       f1        f2        f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  XX        @~        @[        @ly-scr   @lpar     @pct-1pw  @$        @rpar     @}        @]        @+        @`        @#        bspc
  C-tab     C-'       C-,       C-.       C-p       C-y       C-f       C-g       C-c       C-r       C-l       C-/       @at-1pw   C-ret
  @wm-cycle C-a       C-o       C-e       C-u       C-i       C-d       C-h       C-t       C-n       C-s       -         \
  @wm-wsprv @wm-wsprv @;        C-q       C-j       C-k       C-x       C-b       C-m       C-w       C-v       C-z       @ly-rsft
  F3        @pst-cpy  @ly-lhyp  XX        @hr-click                               @hr-srch  @ly-rhyp  left      down      up        rght
)

(deflayer control-r
  esc       f1        f2        f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  XX        @~        @[        @ly-scr   @lpar     @pct-1pw  @$        @rpar     @}        @]        @+        @`        @#        bspc
  C-tab     C-'       C-,       C-.       C-p       C-y       C-f       C-g       C-c       C-r       C-l       C-/       @at-1pw   C-ret
  F3        C-a       C-o       C-e       C-u       C-i       C-d       C-h       C-t       C-n       C-s       -         \
  @wm-wsprv @wm-wsprv @;        C-q       C-j       C-k       C-x       C-b       C-m       C-w       C-v       C-z       @ly-rsft
  lmet      @pst-cpy  @ly-lhyp  XX        @hr-scrl                                rctl      @ly-rhyp  left      down      up        rght
)
