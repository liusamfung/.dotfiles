;; Browser tabs (held from "o").

(defalias
  tab-1 (macro M-1)
  tab-2 (macro M-2)
  tab-3 (macro M-3)
  tab-4 (macro M-4)
  tab-5 (macro M-5)
  tab-6 (macro M-6)
  tab-7 (macro M-7)
  tab-8 (macro M-8)
  tab-9 (macro M-9)

  tab-new (macro M-t)
  tab-cls (macro M-w)

  tab-next (macro M-S-])
  tab-prev (macro M-S-[)

  nav-back (macro M-[)
  nav-fwd  (macro M-])
  tab-last (macro C-tab)
)
(deflayer tabs
  esc       f1        f2        f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  102d      XX        XX        XX        XX        XX        XX        @tab-7    @tab-8    @tab-9    XX        XX        XX        XX
  tab       XX        XX        @nav-back @nav-fwd  XX        @tab-prev @tab-4    @tab-5    @tab-6    @tab-last XX        XX        XX
  esc       XX        XX        @tab-next @tab-prev XX        @tab-next @tab-1    @tab-2    @tab-3    XX        XX        XX
  lsft      caps      XX        XX        XX        XX        XX        @nav-back @nav-fwd  @tab-cls  @tab-new  XX        rsft
  fn        lctl      lalt      lmet      spc                                     rmet      ralt      left      down      up        rght
)
