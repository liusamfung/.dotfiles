;; Terminal panes / prompts (held from "t" and "h") and the tmux window layer.

(defalias
bttmPane  (macro C-j)
topPane_  (macro C-k)
leftPane  (macro C-q)
rightPane (macro C-x)

gridLyt__ (macro C-A-M-y)
stackLyt_ (macro C-A-M-o)
fatLyt___ (macro C-A-M-i)
tallLyt__ (macro C-A-M-u)

zoomPane_ (macro C-A-M-d)

nwHorPane (macro M-ret)
nwVerPane (macro M-ret)
deletPane (macro C-A-M-x)
)

 (deflayer TerminalPaneLayer
    esc       f1       f2       f3       f4       f5       f6       f7       f8       f9       f10       f11       f12
 102d     XX      XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX
    tab    @fatLyt___    @gridLyt__    @zoomPane_ @stackLyt_    XX       XX       XX       XX       XX       XX       XX       XX       XX
      esc      XX       XX       XX       XX       XX       XX    @nwHorPane    XX       XX    @nwVerPane    XX       XX
   lsft    caps     XX    @leftPane @bttmPane @topPane_ @rightPane    XX       XX       XX       XX       XX       rsft
    fn    lctl lalt @deletPane                 spc                     rmet    ralt         left down up  rght
  )

(defalias
reloadCn (macro C-M-,)
nvimNavi (macro M-A-h)
prvPrmpt (macro C-S-e)
nxtPrmpt (macro C-S-u)
LineUP__    (macro-repeat C-S-k)
LineDown  (macro-repeat C-A-S-j)

quickTerm  (macro-repeat C-A-S-spc)

)
 (deflayer TerminalLayer

    @reloadCn       f1       f2       f3       f4       f5       f6       f7       f8       f9       f10       f11       f12
 102d     XX      XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX
    tab       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX
      esc      XX       XX    @nxtPrmpt    @prvPrmpt       @nvimNavi       XX       XX       @LineDown       XX       XX       XX       XX
   lsft    lsft     XX    XX @LineDown @LineUP__    XX    XX       XX       XX       XX       XX       rsft
    fn    lctl lalt lmet                 @quickTerm                     rmet    ralt         left down up  rght
  )

(defalias
 b_prviw (macro C-x $tmux-delay w) ;; -> Preview list of windows(tabs) and sessions
 w_clsTb (macro C-x $tmux-delay @&) ;;  -> Quit current tab. (TmuxPrefix + &)
 v_crtTb (macro C-x $tmux-delay c) ;;  -> Kreate new tab (TmuxPrefix + c)
 r_rnmTb (macro C-x $tmux-delay ,) ;; -> Rename current window (TmuxPrefix + ,)

 h_goTb1 (macro C-x $tmux-delay h) ;; -> -> Go to tab number 1
 t_goTb2 (macro C-x $tmux-delay j) ;; -> -> Go to tab number 2
 n_goTb3 (macro C-x $tmux-delay k) ;; -> -> Go to tab number 3
 g_goTb4 (macro C-x $tmux-delay l) ;; -> -> Go to tab number 4
 c_goTb5 (macro C-x $tmux-delay y) ;; -> -> Go to tab number 5

 ;;       [:dvrk-h [:!Tx :h]] ; (t + h)
 ;;       [:dvrk-t [:!Tx :j]] ; (t + j) -> Go to tab number 2
 ;;       [:dvrk-n [:!Tx :k]] ; (t + k) -> Go to tab number 3
 ;;       [:dvrk-g [:!Tx :l]] ; (t + l) -> Go to tab number 4
 ;;       [:dvrk-c [:!Tx :y]] ; (t + y) -> Go to tab number 5
)

 (deflayer TabsLayer

    esc       f1       f2       f3       f4       f5       f6       f7       f8       f9       f10       f11       f12
 102d     XX      XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX       XX
    tab       XX       XX       XX       XX       XX       XX    @g_goTb4 @c_goTb5 @r_rnmTb    XX       XX       XX       XX
      esc      XX       XX       XX       XX       XX       XX    @h_goTb1 @t_goTb2 @n_goTb3    XX       XX       XX
   lsft    caps     XX       XX       XX       XX       XX    @b_prviw    XX    @w_clsTb @v_crtTb    XX       rsft
    fn    lctl lalt lmet                 spc                     rmet    ralt         left down up  rght
  )
