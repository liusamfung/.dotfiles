;; Entry point. Everything lives in the included files; this one only holds defcfg and the include list.
;;
;; kanata limits: includes are only allowed here (an included file cannot include another one), paths are
;; relative to this file, and an include whose file is missing is silently ignored. A typo in a name shows
;; up as an "undefined alias/layer" error in `kanata --check`, not as a missing-file error.
;;
;;   core/     vars, defsrc, tap-hold activators        (no layers)
;;   shared/   aliases used by more than one layer
;;   layers/   one file per feature: its aliases + its deflayer(s)

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  concurrent-tap-hold yes
)

;; Machine-specific values ($user, $cycle-script). Untracked; see core/local-guard.kbd.
(include local.kbd)
(include core/local-guard.kbd)

(include core/vars.kbd)
(include core/defsrc.kbd)

;; Order matters for an alias that uses another alias (@x inside a defalias): the used one must come first.
;; deflayer bodies don't care. triggers uses the shared aliases, so it goes after them.
(include shared/chars.kbd)
(include shared/shortcuts.kbd)
(include core/triggers.kbd)

;; The first deflayer is the one kanata starts on, so base must stay first.
(include layers/base.kbd)
(include layers/control.kbd)
(include layers/shift.kbd)
(include layers/number.kbd)
(include layers/tabs.kbd)
(include layers/sessions.kbd)
(include layers/workspaces.kbd)
(include layers/windows.kbd)
(include layers/terminal.kbd)
(include layers/screenshot.kbd)
(include layers/system.kbd)
(include layers/quick-apps.kbd)
(include layers/raycast.kbd)
