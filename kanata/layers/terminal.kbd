;; Terminal panes (held from "t") and prompt / scroll control (held from "h"), for kitty.

(defalias
  kt-pdn (macro C-j)
  kt-pup (macro C-k)
  kt-plf (macro C-q)
  kt-prt (macro C-x)

  kt-grid  (macro C-A-M-y)
  kt-stack (macro C-A-M-o)
  kt-fat   (macro C-A-M-i)

  kt-zoom (macro C-A-M-d)

  kt-pnh  (macro M-ret)
  kt-pnv  (macro M-ret)
  kt-pdel (macro C-A-M-x)
)

(deflayer terminal-panes
  esc       f1        f2        f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  102d      XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX
  tab       @kt-fat   @kt-grid  @kt-zoom  @kt-stack XX        XX        XX        XX        XX        XX        XX        XX        XX
  esc       XX        XX        XX        XX        XX        XX        @kt-pnh   XX        XX        @kt-pnv   XX        XX
  lsft      caps      XX        @kt-plf   @kt-pdn   @kt-pup   @kt-prt   XX        XX        XX        XX        XX        rsft
  fn        lctl      lalt      @kt-pdel  spc                                     rmet      ralt      left      down      up        rght
)

(defalias
  kt-rld   (macro C-M-,)
  kt-prmup (macro C-S-e)
  kt-prmdn (macro C-S-u)
  kt-sup   (macro-repeat C-S-k)
  kt-sdn   (macro-repeat C-A-S-j)

  kt-quick (macro-repeat C-A-S-spc)
)
(deflayer terminal
  @kt-rld   f1        f2        f3        f4        f5        f6        f7        f8        f9        f10       f11       f12
  102d      XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX
  tab       XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX        XX
  esc       XX        XX        @kt-prmdn @kt-prmup XX        XX        XX        @kt-sdn   XX        XX        XX        XX
  lsft      lsft      XX        XX        @kt-sdn   @kt-sup   XX        XX        XX        XX        XX        XX        rsft
  fn        lctl      lalt      lmet      @kt-quick                               rmet      ralt      left      down      up        rght
)
