;; Tap-hold activators: hold = layer / modifier, tap = the key itself. Used by layers/base.kbd and layers/control.kbd.

(defalias
  ly-wsmv  (layer-toggle workspaces-move)
  ly-winmv (layer-toggle windows-move)

  ly-lhyp (tap-hold-press  $tap-time $hold-time @hr-click (layer-toggle quick-apps))
  ly-rsft (tap-hold-press  $tap-time $hold-time XX (layer-toggle shift-r))
  ly-rhyp (tap-hold-press  $tap-time $hold-time @hr-scrl (layer-toggle quick-apps))
  ly-lsft (tap-hold-press  $tap-time $hold-time XX (layer-toggle shift-l))

  ly-ctl  (tap-hold-press  $tap-time $hold-time bspc (layer-toggle control-l))
  ly-rctl (tap-hold-press  $tap-time $hold-time ret  (layer-toggle control-r))

  ly-num (tap-hold $tap-time $hold-time spc (layer-toggle number))

  ly-sys (tap-hold $tap-time $hold-time s (layer-toggle system)) ;; trickster

  ly-scr (tap-hold $tap-time $hold-time @{ (layer-toggle screenshot))

  ly-tab (tap-hold $tap-time $hold-time o (layer-toggle tabs))
  ly-ws  (tap-hold $tap-time $hold-time e (layer-toggle workspaces))
  ly-ses (tap-hold $tap-time $hold-time u (layer-toggle sessions))
  ly-qck (tap-hold $tap-time $hold-time a (layer-toggle quick-apps))

  ly-pane (tap-hold $tap-time $hold-time t (layer-toggle terminal-panes))
  ly-term (tap-hold $tap-time $hold-time h (layer-toggle terminal))
  ly-win  (tap-hold $tap-time $hold-time n (layer-toggle windows))

  mod-la (tap-hold $tap-time $hold-time ' ralt)
  mod-lc (tap-hold $tap-time $hold-time , lctl)
  mod-lm (tap-hold $tap-time $hold-time . lmet)
  mod-ls (tap-hold $tap-time $hold-time p lsft)

  mod-rs (tap-hold $tap-time $hold-time g rsft)
  mod-rm (tap-hold $tap-time $hold-time c rmet)
  mod-rc (tap-hold $tap-time $hold-time r lctl)
  mod-ra (tap-hold $tap-time $hold-time l ralt)
)

(defalias
  at-1pw  (tap-hold $tap-time $hold-time @@ C-A-M-p) ;; trickster
  pct-1pw (tap-hold $tap-time $hold-time @% C-A-M-p) ;; trickster
  pst-cpy (tap-hold $tap-time $hold-time M-v M-c) ;;Copy paste
)
