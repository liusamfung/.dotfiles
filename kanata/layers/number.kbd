;; Numpad layer held from space. Reuses the word-jump aliases defined in layers/navigation.kbd.

(deflayer number
  esc  XX   XX   XX   XX   XX   XX   @/   @*   @-   XX  XX  XX
  XX  XX    XX    XX    XX    XX    XX    7   8    9   @+    XX    XX    bspc
  tab  ralt   lctl    lsft    lmet    XX    XX    4    5    6    @+    @/    XX    ret
  esc XX    @o_leftC @e_leftO @u_rgthO @i_rgthC XX    1    2    3    ret    XX    XX
  lsft caps @:    left  down  up  rght   ,    0   0   .    XX    rsft
  lmet lctl lalt bspc        spc        rsft ralt left down up   rght
)
